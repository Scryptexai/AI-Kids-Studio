{
  "name": "kids-ai-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Internal production studio for AI-generated kids animation video series. Not a game, not an end-user app.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "doctor": "node scripts/doctor.mjs",
    "assets:manifest": "node scripts/assets/manifest.mjs",
    "assets:validate": "node scripts/assets/validate.mjs",
    "assets:restore": "node scripts/assets/restore.mjs",
    "voice:engines": "node scripts/voice/engines.mjs",
    "voice:audition": "node scripts/voice/audition.mjs",
    "voice:generate": "node scripts/voice/generate.mjs",
    "voice:validate": "node scripts/voice/validate.mjs",
    "episode:validate": "node scripts/episode/validate.mjs",
    "episode:render": "node scripts/episode/render.mjs",
    "render:preview": "node scripts/episode/preview.mjs",
    "validate": "npm run assets:validate && npm run voice:validate && node scripts/episode/validate.mjs --all",
    "test": "node --test",
    "renderer:bench": "node scripts/bench/renderer.mjs",
    "pkg:inspect": "node scripts/tools/inspect-package.mjs",
    "blender:probe": "node scripts/tools/probe-blender.mjs",
    "studio": "node apps/studio/server.mjs",
    "studio:direct": "node scripts/studio/direct.mjs"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@remotion/bundler": "^4.0.541",
    "@remotion/cli": "^4.0.541",
    "@remotion/renderer": "^4.0.541",
    "@resvg/resvg-js": "^2.6.2",
    "@sparticuz/chromium": "^153.0.0",
    "@volter/blender-engine": "^0.1.149",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dejavu-fonts-ttf": "^2.37.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.541"
  }
}
