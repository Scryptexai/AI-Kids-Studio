# Copy to .env and fill in. NEVER commit the real file.
# Every value here is optional: the studio must bootstrap and validate without them.

# ---- External TTS: remote HTTP engine (recommended production path) ----
# Run VoxCPM 2 / XTTS on a machine that can actually reach the model weights,
# wrap it in the contract described in docs/VOICE-PIPELINE.md#remote-execution.
TTS_HTTP_ENDPOINT=
TTS_HTTP_TOKEN=

# ---- Local engine paths (only if the weights exist on this machine) ----
VOXCPM_WEIGHTS_PATH=
XTTS_WEIGHTS_PATH=
OPENVOICE_WEIGHTS_PATH=
RVC_MODEL_PATH=

# ---- eSpeak NG (smoke-test engine, built by npm run bootstrap) ----
ESPEAK_BIN=
ESPEAK_DATA_PATH=

# ---- Google Drive persistence (GitHub Actions + local restore) ----
# Path to a service-account JSON key with Drive scope. Never commit it.
GDRIVE_SERVICE_ACCOUNT_JSON=
GDRIVE_FOLDER_ID=

# ---- Logging ----
# debug | info | warn | error
STUDIO_LOG_LEVEL=info
